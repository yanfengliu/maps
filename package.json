{
  "name": "maps",
  "private": true,
  "version": "0.0.0",
  "description": "Turn 3d maps into simulated worlds.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:fetch": "node tools/data/fetch.ts",
    "data:tiles": "node tools/data/fetch-tiles.ts",
    "data:scene": "node tools/scene/build.ts",
    "data:pavements": "node tools/scene/build-pavements.ts",
    "data:markings": "node tools/scene/build-markings.ts",
    "data:decorations": "node tools/data/fetch-decorations.ts && node tools/scene/build-decorations.ts",
    "data:hardware": "node tools/scene/build-control-hardware.ts",
    "data:textures:verify": "node tools/visual/texture-budget.ts",
    "data:paint-reference": "node tools/data/fetch-paint-reference.ts",
    "data:setup": "npm run data:fetch && npm run data:scene && npm run data:textures:verify && npm run data:network && npm run data:paint-reference && npm run data:markings && npm run data:decorations && npm run data:vehicles && npm run data:hardware",
    "data:network": "node tools/network/build.ts",
    "visual": "node tools/visual/verify-output.ts --reset && npm run build && node tools/visual/verify-output.ts --begin && playwright test --config playwright.config.ts && playwright test --config playwright.lifecycle.config.ts --repeat-each=3 && node tools/visual/verify-output.ts --end",
    "visual:populated": "playwright test --config playwright.populated.config.ts",
    "visual:populated:aim": "node tools/populated/probe.ts --ticks 5400",
    "visual:flythrough": "playwright test --config playwright.flythrough.config.ts",
    "capture:render-defects": "playwright test --config playwright.render-defects.config.ts",
    "visual:smoke": "playwright test --config playwright.smoke.config.ts",
    "visual:post-chain": "playwright test --config tools/post-chain/playwright.config.ts",
    "visual:flicker": "playwright test --config tools/flicker/playwright.config.ts",
    "visual:install": "playwright install chromium",
    "audit": "npm audit --audit-level=high",
    "artifacts:size": "node tools/storage/artifact-size.ts",
    "data:vehicles": "node tools/agents/build-vehicles.ts",
    "data:vehicles:verify": "node tools/agents/verify-vehicles.ts",
    "data:agents": "node tools/agents/build.ts",
    "data:agents:verify": "node tools/agents/verify.ts",
    "data:agents:set": "node tools/agents/verify-human-set.ts",
    "data:agents:manifests": "node tools/agents/manifests.ts"
  },
  "dependencies": {
    "3d-tiles-renderer": "^0.5.2",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.5.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
