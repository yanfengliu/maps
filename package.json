{
  "name": "maps",
  "private": true,
  "version": "0.0.0",
  "description": "Turn 3d maps into simulated worlds.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
